{
    "name": "erp-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "@primevue/themes": "^4.2.0",
        "@tanstack/vue-query": "^5.59.0",
        "@vee-validate/zod": "^4.13.0",
        "axios": "^1.7.0",
        "pinia": "^2.2.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.2.0",
        "vee-validate": "^4.13.0",
        "vue": "^3.5.0",
        "vue-router": "^4.4.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^5.1.0",
        "@vue/eslint-config-typescript": "^14.1.0",
        "@vue/test-utils": "^2.4.0",
        "eslint": "^9.13.0",
        "eslint-plugin-vue": "^9.30.0",
        "jsdom": "^25.0.0",
        "prettier": "^3.3.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.6.0",
        "vite": "^6.0.0",
        "vitest": "^2.1.0",
        "vue-tsc": "^2.1.0"
    }
}
